# Container process UID/GID on Raspberry Pi (normally 1000).
PUID=1000
PGID=1000
TOSS_BASE_URL=https://openapi.tossinvest.com
TOSS_TIMEOUT_SECONDS=10
TOSS_MAX_RETRIES=2
