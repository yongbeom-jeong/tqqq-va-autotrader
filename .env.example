SYMBOL=TQQQ
RESERVE_SYMBOL=SGOV
VA_PATH_FILE=data/va_path.csv
DRY_RUN=true
MAX_ORDER_AMOUNT_USD=5000
ORDER_FILL_TIMEOUT_SECONDS=60
ORDER_POLL_INTERVAL_SECONDS=2
